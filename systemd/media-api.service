[Unit]
Description=Media Processing FastAPI Service
After=network.target

[Service]
User=homelab
Group=homelab
WorkingDirectory=/opt/homelab/services/media-api
ExecStart=/opt/homelab/services/media-api/venv/bin/uvicorn app:app --host 127.0.0.1 --port 5000
Restart=always
RestartSec=5

# Hardening that suits a web app writing only under /opt/homelab: check with `systemd-analyze security <unit>`.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
