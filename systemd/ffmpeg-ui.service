[Unit]
Description=FFmpeg Web UI Service
After=network.target

[Service]
User=homelab
Group=homelab
WorkingDirectory=/opt/homelab/services/ffmpeg-ui
ExecStart=/opt/homelab/services/ffmpeg-ui/start.sh
Restart=on-failure
RestartSec=5

# Hardening that suits a web app writing only under /opt/homelab: check with `systemd-analyze security <unit>`.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
