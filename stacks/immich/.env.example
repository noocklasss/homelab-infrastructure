# Storage locations on the host
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres

# Timezone
TZ=Europe/Athens

# Immich release channel or pinned version (e.g., v3.4.1)
IMMICH_VERSION=v3

# PostgreSQL credentials (generate a strong alphanumeric password in .env)
DB_PASSWORD=CHANGE_ME_STRONG_ALPHANUMERIC_PASSWORD
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
