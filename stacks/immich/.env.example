# Storage locations on the host
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres

# Timezone
TZ=Europe/Athens

# Pinned Immich release (upgrade deliberately, after reading the release notes)
IMMICH_VERSION=v3.4.1

# Address the Immich port (2283) is published on. 127.0.0.1 = reachable only through Nginx.
IMMICH_BIND_ADDRESS=127.0.0.1

# PostgreSQL credentials (generate a strong alphanumeric password in .env)
DB_PASSWORD=CHANGE_ME_STRONG_ALPHANUMERIC_PASSWORD
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
